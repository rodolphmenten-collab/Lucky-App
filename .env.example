# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key — server-only, NEVER exposed to the client bundle.
# Used by scripts/seed.ts and the /admin back-office aggregate queries.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public URL of this deployment, used to build QR codes in /dashboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed into /admin.
ADMIN_EMAILS=you@example.com

# Resend — used directly (not through Supabase's own email templates) to send
# 6-digit sign-in codes, so delivery no longer depends on the Supabase dashboard's
# email template editor.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@lucky-app.io
